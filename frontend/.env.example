# ==========================================
# SUNGROW PLATFORM - ENVIRONMENT VARIABLES
# ==========================================

# 1. JWT Authentication Secrets (Must be at least 32 characters in production)
# Generate securely via: openssl rand -base64 32
JWT_ACCESS_SECRET="your_production_jwt_access_secret_key_minimum_32_chars_here"
JWT_REFRESH_SECRET="your_production_jwt_refresh_secret_key_minimum_32_chars_here"

# 2. Email Delivery Service (Resend)
# Optional in local development (console/JSON transport is used if omitted)
# Required in production for delivering actual email OTP verification codes
RESEND_API_KEY="re_123456789_placeholder"
EMAIL_FROM="no-reply@sungrowpower.com"

# 3. Node Environment
NODE_ENV="development"
